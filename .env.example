# ─────────────────────────────────────────────────────────────
# Sellio environment variables.
# Copy this file to `.env` and fill in your own values.
# Do NOT commit `.env` — it's gitignored.
# ─────────────────────────────────────────────────────────────

# Supabase (create a free project at https://supabase.com)
# Project Settings → API → "Project URL", "Project API keys" (anon/public)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side reads the same values (no VITE_ prefix) for the
# requireSupabaseAuth middleware + client.server.ts service-role client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Optional — only if a route uses supabaseAdmin (service-role bypass of RLS).
# None of the AI server functions need this; it's for future privileged ops.
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA NIM API key — get one at https://build.nvidia.com
# The 5 AI server functions call https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your-nvidia-nim-key
